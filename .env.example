# ============================================================
#  MemoryVault — paste your keys here, then:  cp .env.example .env
#  Everything below activates automatically when a key is present.
#  Leave blank to run the demo on safe local defaults.
# ============================================================

# ---- STORAGE (blank = SQLite demo; set = Postgres+pgvector) ----
DATABASE_URL=
# e.g. postgres://user:pass@host:5432/memoryvault

# ---- ENCRYPTION (customer KMS — "we can't read your data") ----
MV_ENCRYPT=
MV_KMS_PROVIDER=local            # local | aws
MV_KMS_KEY_ID=                   # your AWS CMK ARN (if aws)

# ---- EMBEDDINGS (blank = local; openai = real semantic) ----
MV_EMBEDDINGS=local              # local | openai
OPENAI_API_KEY=

# ---- CONNECTORS: paste a token, that platform goes LIVE ----
SALESFORCE_TOKEN=
SALESFORCE_INSTANCE_URL=         # https://yourco.my.salesforce.com
MS_GRAPH_TOKEN=
INTERCOM_TOKEN=
MEM0_API_KEY=
ZEP_API_KEY=
ZEP_BASE_URL=https://api.getzep.com
OPENAI_EXPORT_FILE=              # path to ChatGPT Enterprise compliance export

# ---- BILLING (paste Stripe key to turn on real billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM=           # price_... (base subscription)
STRIPE_PRICE_CONNECTOR=          # price_... (metered per connected system)

# ---- RUNTIME ----
MV_SYNC_INTERVAL=3600            # durable full-sync cadence (seconds)
